<!--
This file contains the declaration of all the localizable strings.
-->
<WixLocalization xmlns="http://wixtoolset.org/schemas/v4/wxl" Culture="en-US">

  <String Id="WizDowngradeError" Overridable="yes" Value="A newer version of [ProductName] is already installed." />
  
  <String Id="WelcomeMessage" Overridable="yes" Value="Welcome to setup for [ProductName]." />

</WixLocalization>
